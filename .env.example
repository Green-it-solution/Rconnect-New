# Zoho Mail SMTP configuration
# Use the Zoho mailbox that has SMTP enabled.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-mailbox@rconnect.info
SMTP_PASS=YOUR_ZOHO_SMTP_PASSWORD_OR_APP_PASSWORD

# This should normally match the authenticated Zoho mailbox or a verified alias.
MAIL_FROM=your-mailbox@rconnect.info

# All website Contact/Quote notifications will be delivered here.
MAIL_TO=purchase@rconnect.info,accounts@rconnect.info,support@rconnect.info

# Optional; defaults to 3000.
PORT=3000
